# Sicurezza di base su tutto il sito
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  #
  # Content-Security-Policy: elenca le uniche origini da cui il browser puo'
  # caricare qualcosa. Conta soprattutto per il corpo degli articoli: il
  # prerender lo prende dal database e lo inietta nella pagina dopo averlo
  # ripulito con espressioni regolari, che e' un metodo storicamente
  # aggirabile. La CSP e' la seconda rete: anche se un tag pericoloso
  # passasse, lo script non partirebbe.
  #
  # Ogni voce corrisponde a qualcosa che il sito usa davvero:
  #   script  cdnjs = React, cloud.umami.is = statistiche, l'hash = lo
  #           script inline nel <body> che fissa il viewport
  #   style   'unsafe-inline' e' inevitabile: React e il prerender scrivono
  #           gli stili dentro l'attributo style di ogni elemento
  #   img     supabase = le copertine, img.youtube = le anteprime dei video,
  #           data: = le immagini incorporate
  #   connect supabase = articoli e iscrizioni, umami = invio statistiche
  #   frame   solo gli embed YouTube
  #   form-action 'self' impedisce che un modulo iniettato spedisca altrove
  #   object-src 'none' chiude plugin e <embed>
  #
  # Se un giorno aggiungi un servizio esterno e "non funziona", la console
  # del browser dice esattamente quale riga lo sta bloccando.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cloud.umami.is 'sha256-3sgerl2LYMr70k+UBpH5ueGZWg1sxL6wqOdJnINkSmI='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://wzkshpgakvasqwrrgkgd.supabase.co https://img.youtube.com; connect-src 'self' https://wzkshpgakvasqwrrgkgd.supabase.co https://cloud.umami.is https://gateway.umami.is; frame-src https://www.youtube.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# app.js non ha un hash nel nome: cache breve lato browser,
# ma la CDN puo' tenerlo piu' a lungo e rivalidare in background.
/app.js
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# Risorse immutabili: cambiano solo se cambia il nome del file
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon-192.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/og-default.jpg
  Cache-Control: public, max-age=2592000
